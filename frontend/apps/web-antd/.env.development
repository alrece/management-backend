# 端口号
VITE_PORT=5666

VITE_BASE=/

# 请求路径（Go 后端地址，用于生产环境直连）
VITE_BASE_URL=http://127.0.0.1:8081
# 接口地址（Vite 代理前缀）
VITE_GLOB_API_URL=/api
# 文件上传类型：server - 后端上传
VITE_UPLOAD_TYPE=server
# 是否打开 devtools
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 默认登录用户名
VITE_APP_DEFAULT_USERNAME=admin
# 默认登录密码
VITE_APP_DEFAULT_PASSWORD=admin123
